{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/product-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/product-service/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/product-service",
  "projects": {
    "coupon-service": {
      "type": "application",
      "root": "apps/coupon-service",
      "entryFile": "main",
      "sourceRoot": "apps/coupon-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/coupon-service/tsconfig.app.json"
      }
    },
    "member-service": {
      "type": "application",
      "root": "apps/member-service",
      "entryFile": "main",
      "sourceRoot": "apps/member-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/member-service/tsconfig.app.json"
      }
    },
    "order-service": {
      "type": "application",
      "root": "apps/order-service",
      "entryFile": "main",
      "sourceRoot": "apps/order-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/order-service/tsconfig.app.json"
      }
    },
    "product-service": {
      "type": "application",
      "root": "apps/product-service",
      "entryFile": "main",
      "sourceRoot": "apps/product-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/product-service/tsconfig.app.json"
      }
    },
    "ware-service": {
      "type": "application",
      "root": "apps/ware-service",
      "entryFile": "main",
      "sourceRoot": "apps/ware-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ware-service/tsconfig.app.json"
      }
    }
  }
}